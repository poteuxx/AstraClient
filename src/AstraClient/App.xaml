<Application x:Class="AstraClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AstraClient.Converters"
             xmlns:vm="clr-namespace:AstraClient.ViewModels"
             xmlns:views="clr-namespace:AstraClient.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Glass.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:CompactNumberConverter x:Key="CompactNumber" />
            <conv:RelativeDateConverter x:Key="RelativeDate" />
            <conv:NullToPlaceholderConverter x:Key="NullPlaceholder" />
            <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis" />
            <conv:IntColorToBrushConverter x:Key="IntColorToBrush" />

            <!-- ViewModel -> View templates -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}">
                <views:HomeView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BrowseViewModel}">
                <views:BrowseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ManageViewModel}">
                <views:ManageView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AternosViewModel}">
                <views:AternosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OutputConsoleViewModel}">
                <views:OutputConsoleView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
