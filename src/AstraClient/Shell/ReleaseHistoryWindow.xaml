<Window x:Class="AstraClient.Shell.ReleaseHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Astra Client Release History" Width="900" Height="650" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="Transparent" AllowsTransparency="True" ShowInTaskbar="False">
    <Border CornerRadius="16" Background="{DynamicResource Brush.App.Background}"
            BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
            Effect="{DynamicResource Effect.Flyout.Shadow}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="16,16,0,0" Background="{DynamicResource Brush.TitleBar.Fill}"
                    BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Refresh}" Width="20" Height="20" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                        <StackPanel><TextBlock Text="Release history" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Text="Astra Client v1.31 through v1.0" Style="{StaticResource Text.Caption}"/></StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Width="34" Height="34" Click="Close_Click">
                        <Path Data="{StaticResource Icon.Close}" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Brush.Text.Secondary}"/>
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
                <ItemsControl ItemsSource="{Binding Releases}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Style="{StaticResource Card.Panel}" Padding="18" Margin="0,0,0,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource Brush.Selection}" CornerRadius="8" Padding="8,5" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionHeader}"/>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" Margin="0,5,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Features}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2"><Path Data="{StaticResource Icon.Check}" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource Brush.Success}" Margin="0,2,8,0"/>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/></StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Grid.Row="2" CornerRadius="0,0,16,16" Padding="18,10" BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,1,0,0">
                <Button HorizontalAlignment="Right" Style="{StaticResource Button.Primary}" Padding="28,9" Click="Close_Click"><TextBlock Text="Close" Foreground="White" FontWeight="SemiBold"/></Button>
            </Border>
        </Grid>
    </Border>
</Window>
