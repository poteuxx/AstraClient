<Window x:Class="AstraClient.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Astra Client" Icon="pack://application:,,,/Assets/astra_logo.ico"
        Width="520" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border CornerRadius="14"
            Background="{DynamicResource Brush.App.Background}"
            BorderBrush="{DynamicResource Brush.Glass.Border}"
            BorderThickness="1"
            Effect="{DynamicResource Effect.Flyout.Shadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Ambient glow -->
            <Border Grid.RowSpan="3" CornerRadius="14" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush GradientOrigin="0.5,0.1" Center="0.5,0.1" RadiusX="0.8" RadiusY="0.5">
                        <GradientStop Color="#1A7C8CFF" Offset="0"/>
                        <GradientStop Color="#007C8CFF" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0" Height="46" CornerRadius="14,14,0,0"
                    Background="{DynamicResource Brush.TitleBar.Fill}"
                    BorderBrush="{DynamicResource Brush.Separator}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="About Astra Client · v1.31" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Style="{StaticResource IconButton}" Width="32" Height="32"
                            Click="CloseButton_Click">
                        <Path Data="{StaticResource Icon.Close}" Width="13" Height="13" Stretch="Uniform"
                              Fill="{DynamicResource Brush.Text.Secondary}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Body ── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="36,28" HorizontalAlignment="Center">

                    <!-- Logo -->
                    <Border Width="72" Height="72" CornerRadius="20"
                            Background="{DynamicResource Brush.Accent.Gradient}"
                            HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.5" Color="#7C8CFF"/>
                        </Border.Effect>
                        <Path Data="{StaticResource Icon.Sparkle}" Fill="White"
                              Width="38" Height="38" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- App name -->
                    <TextBlock HorizontalAlignment="Center" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}">
                        <Run Text="Astra"/><Run Text=" Client" Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="Normal"/>
                    </TextBlock>

                    <!-- Version row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,6">
                        <Border CornerRadius="6" Background="{DynamicResource Brush.Selection}"
                                Padding="10,4" Margin="0,0,8,0">
                            <TextBlock x:Name="VersionLabel"
                                       FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                        <Border CornerRadius="6" Background="{DynamicResource Brush.Glass.Card}"
                                BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
                                Padding="10,4">
                            <TextBlock x:Name="BuildLabel" FontSize="12" FontFamily="Consolas"
                                       Foreground="{DynamicResource Brush.Text.Muted}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="BuildDateLabel" HorizontalAlignment="Center"
                               Style="{StaticResource Text.Caption}" Margin="0,0,0,24"/>

                    <!-- Separator -->
                    <Border Style="{StaticResource HSeparator}" Margin="0,0,0,20" Width="360"/>

                    <!-- Description -->
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                               Style="{StaticResource Text.Body}" FontSize="13"
                               Margin="0,0,0,20"
                               Text="Astra Client is a modern, open-source Minecraft launcher built for Windows 11. It provides a premium dark-glass interface with live Modrinth content discovery, multi-instance management, full Microsoft and offline authentication, and support for Vanilla, Fabric, Quilt, Forge and NeoForge."/>

                    <!-- Tech specs -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16" Width="400">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                       Text="BUILD INFORMATION"
                                       Style="{StaticResource Text.Caption}" FontWeight="Bold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Text.Caption}"
                                       Text="Framework" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Text=".NET 8.0 + WPF" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Text.Caption}"
                                       Text="Architecture" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                       Text="MVVM, hand-rolled DI" Margin="0,0,0,6"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Text.Caption}"
                                       Text="Runtime"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RuntimeLabel"
                                       FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                        </Grid>
                    </Border>

                    <!-- Features list -->
                    <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16" Width="400">
                        <StackPanel>
                            <TextBlock Text="FEATURES" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" Margin="0,0,0,12"/>
                            <ItemsControl>
                                <ItemsControl.Items>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Live Modrinth browser — mods, packs, shaders, datapacks</system:String>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Multi-instance management with per-instance loaders</system:String>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Fabric · Quilt · Forge · NeoForge loader installation</system:String>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Microsoft device-code OAuth2 + offline authentication</system:String>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Automatic Java runtime download from Mojang CDN</system:String>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Full asset + library download pipeline with progress</system:String>
                                    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib">Frosted-glass Win11 aesthetic with custom chrome</system:String>
                                </ItemsControl.Items>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <Path Data="{StaticResource Icon.Check}"
                                                  Width="13" Height="13" Stretch="Uniform"
                                                  Fill="{DynamicResource Brush.Success}" Margin="0,0,8,0"
                                                  VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding}" FontSize="12.5"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Links -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button Style="{StaticResource Button.Ghost}" Padding="14,8" Margin="0,0,8,0"
                                Click="ReleaseHistory_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.ExternalLink}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="Release history" Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Ghost}" Padding="14,8"
                                Click="ModrinthLink_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.ExternalLink}"
                                      Width="13" Height="13" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent}" Margin="0,0,6,0"/>
                                <TextBlock Text="Modrinth" Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Copyright -->
                    <TextBlock x:Name="CopyrightLabel" HorizontalAlignment="Center"
                               Style="{StaticResource Text.Caption}" Margin="0,16,0,4"/>
                    <TextBlock Text="MIT License · No warranty expressed or implied."
                               HorizontalAlignment="Center"
                               Style="{StaticResource Text.Caption}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Footer / close ── -->
            <Border Grid.Row="2" Padding="20,12"
                    BorderBrush="{DynamicResource Brush.Separator}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,14,14">
                <Button Style="{StaticResource Button.Primary}"
                        HorizontalAlignment="Center"
                        Padding="30,10"
                        Click="CloseButton_Click">
                    <TextBlock Text="Close" FontWeight="SemiBold" Foreground="White"/>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
