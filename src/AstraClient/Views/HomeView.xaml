<UserControl x:Class="AstraClient.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AstraClient.Converters">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: Version list -->
            <ColumnDefinition Width="340" MinWidth="260"/>
            <!-- Right: Active instance hero + detail -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════ LEFT — Version Framework ═══════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Chrome.Fill}"
                BorderBrush="{DynamicResource Brush.Separator}"
            BorderThickness="0,0,1,0"
            CornerRadius="12,0,0,12"
            ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="18,18,18,0">
                    <TextBlock Text="VERSION FRAMEWORK" Style="{StaticResource Text.Caption}"
                               FontWeight="Bold"/>
                </StackPanel>

                <!-- Search box -->
                <Grid Grid.Row="1" Margin="12,10,12,0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource TextBox.Base}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="38,9,12,9"/>
                    <Path Data="{StaticResource Icon.Search}"
                          Fill="{DynamicResource Brush.Text.Muted}"
                          Width="16" Height="16" Stretch="Uniform"
                          HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <!-- Watermark -->
                    <TextBlock Text="Search versions…" IsHitTestVisible="False"
                               Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="40,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filter chips -->
                <WrapPanel Grid.Row="2" Margin="12,8,12,4">
                    <ToggleButton Style="{StaticResource Chip}"
                                  IsChecked="{Binding ShowSnapshots, Mode=TwoWay}"
                                  Content="Snapshots"/>
                    <ToggleButton Style="{StaticResource Chip}"
                                  IsChecked="{Binding ShowOldVersions, Mode=TwoWay}"
                                  Content="Legacy (Alpha/Beta)"/>
                    <Button Style="{StaticResource Button.Ghost}"
                            Command="{Binding RefreshCommand}"
                            Padding="10,5" Margin="0,0,0,8" FontSize="11.5"
                            ToolTip="Reload version list from Mojang">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Refresh}"
                                  Width="12" Height="12" Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,5,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <!-- Version groups scroll list -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="12,0,6,12">
                    <ItemsControl ItemsSource="{Binding VersionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Group -->
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          Margin="0,3,0,0">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding GroupKey}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    </Expander.Header>
                                    <Expander.Style>
                                        <Style TargetType="Expander">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </Expander.Style>
                                    <!-- Version items inside the group -->
                                    <ItemsControl ItemsSource="{Binding Versions}" Margin="0,2,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectVersionCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Button.Ghost}"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="10,7" Margin="0,1" BorderThickness="0"
                                                        Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                        <!-- Type badge -->
                                                        <Border Grid.Column="1" CornerRadius="4"
                                                                Padding="5,2" Margin="6,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#1A7C8CFF"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Type}" Value="snapshot">
                                                                            <Setter Property="Background" Value="#1AE7B45A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="old_beta">
                                                                            <Setter Property="Background" Value="#1AF0757F"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Type}" Value="old_alpha">
                                                                            <Setter Property="Background" Value="#1AF0757F"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="Release"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Type}" Value="snapshot">
                                                                                <Setter Property="Text" Value="Snap"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="old_beta">
                                                                                <Setter Property="Text" Value="Beta"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Type}" Value="old_alpha">
                                                                                <Setter Property="Text" Value="Alpha"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding ReleaseTime, StringFormat='{}{0:yyyy-MM-dd}'}"
                                                                   Style="{StaticResource Text.Caption}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Loading overlay -->
                <Border Grid.Row="3" Background="#AA0B0E16"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Loading versions…" Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════ RIGHT — Hero + Play ═══════════════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Active Instance Hero Card ── -->
                <Border Grid.Row="0" Style="{StaticResource Card.Panel}" Padding="28" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Title row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Instance" Style="{StaticResource Text.Caption}"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding ActiveInstanceLabel}"
                                           Style="{StaticResource Text.SectionHeader}"
                                           FontSize="18"/>
                            </StackPanel>
                            <!-- No instance hint -->
                            <Border Grid.Column="1" CornerRadius="8" Background="#1AF0757F"
                                    Padding="10,5"
                                    Visibility="{Binding HasActiveInstance, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="No instance selected" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.Danger}"/>
                            </Border>
                        </Grid>

                        <!-- Selected version display -->
                        <Border Grid.Row="1" Margin="0,16,0,0" Padding="14,10"
                                Background="{DynamicResource Brush.Glass.Card}" CornerRadius="10"
                                BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
                                Visibility="{Binding HasActiveInstance, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Cube}"
                                      Width="20" Height="20" Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                               Text="Minecraft"/>
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                               Text="{Binding ActiveInstance.GameVersion}"/>
                                </StackPanel>
                                <Border Width="1" Background="{DynamicResource Brush.Separator}" Margin="16,0"/>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                               Text="Loader"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="20" Height="20" CornerRadius="6"
                                                Background="{Binding ActiveLoaderVisual.Brush}" Margin="0,0,6,0">
                                            <Grid>
                                                <Image Source="{Binding ActiveLoaderVisual.ImageSource}" Width="16" Height="16" Stretch="Uniform"/>
                                                <Path Data="{Binding ActiveLoaderVisual.Icon}" Fill="White"
                                                      Width="12" Height="12" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ActiveLoaderVisual.ImageSource}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <TextBlock FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                   Text="{Binding ActiveLoaderVisual.DisplayName}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveLoaderVersion}"
                                               Style="{StaticResource Text.Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Width="1" Background="{DynamicResource Brush.Separator}" Margin="16,0"/>
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Brush.Text.Muted}"
                                               Text="Memory"/>
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} MB">
                                                <Binding Path="ActiveInstance.MemoryMb"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Progress bar -->
                        <ProgressBar Grid.Row="2" Style="{StaticResource SoftProgressBar.Large}"
                                     Value="{Binding LaunchProgress}" Maximum="100"
                                     Margin="0,16,0,0"
                                     Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}"/>

                        <!-- Status text -->
                        <TextBlock Grid.Row="3"
                                   Text="{Binding LaunchStatus}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding LaunchStatus, Converter={StaticResource StringEmptyToVis},
                                       ConverterParameter=Invert}"/>

                        <!-- Play Button -->
                        <Button Grid.Row="4"
                                Style="{StaticResource Button.Play}"
                                Command="{Binding PlayCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0"
                                IsEnabled="{Binding IsLaunching, Converter={StaticResource InverseBool}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Play}"
                                      Width="18" Height="18" Stretch="Uniform"
                                      Fill="White" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding PlayLabel}" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Selected Version Info (when user clicks a version) ── -->
                <Border Grid.Row="1" Padding="20" Margin="0,0,0,20"
                        Visibility="{Binding SelectedVersion, Converter={StaticResource NullPlaceholder},
                            ConverterParameter=hidden}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedVersion}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SELECTED VERSION" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding SelectedVersion.Id}"
                                       FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Text.Primary}"/>
                            <TextBlock Margin="0,4,0,0">
                                <Run Text="{Binding SelectedVersion.Type}" Foreground="{DynamicResource Brush.Accent}"/>
                                <Run Text="  ·  " Foreground="{DynamicResource Brush.Text.Muted}"/>
                                <Run Text="{Binding SelectedVersion.ReleaseTime, StringFormat='{}{0:MMMM d, yyyy}'}"
                                     Foreground="{DynamicResource Brush.Text.Muted}"/>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                   Text="Click Play to launch this version →"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ── Instances quick-list ── -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="INSTANCES" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                       Text="Manage → to create" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Empty state -->
                        <TextBlock Text="No instances yet — go to Manage to create one."
                                   Margin="0,8">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Instances.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ItemsControl ItemsSource="{Binding Instances}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,4"
                                            Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <TextBlock Margin="0,2,0,0" FontSize="11.5"
                                                           Foreground="{DynamicResource Brush.Text.Muted}">
                                                    <Run Text="{Binding GameVersion}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding Loader}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding MemoryMb}"/>
                                                    <Run Text="MB"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                                       Text="{Binding LastPlayed, StringFormat='Last: {0:M/d/yy}'}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Status bar bottom -->
        <Border Grid.Column="1" VerticalAlignment="Bottom" Margin="28,0,28,8"
                Visibility="{Binding LaunchStatus, Converter={StaticResource StringEmptyToVis},
                    ConverterParameter=Invert}">
            <TextBlock Text="{Binding LaunchStatus}" Style="{StaticResource Text.Caption}"
                       HorizontalAlignment="Right"/>
        </Border>
    </Grid>
</UserControl>
