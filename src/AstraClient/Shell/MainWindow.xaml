<Window x:Class="AstraClient.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interop="clr-namespace:AstraClient.Interop"
        xmlns:vm="clr-namespace:AstraClient.ViewModels"
        xmlns:views="clr-namespace:AstraClient.Views"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="Astra Client" Icon="pack://application:,,,/Assets/astra_logo.ico"
        Width="1280" Height="800" MinWidth="1024" MinHeight="648"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF0B0E16"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        KeyDown="MainWindow_KeyDown"
        interop:WindowBehavior.Enable="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0"
                     />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <tb:TaskbarIcon x:Key="TrayIconRes"
                        x:Name="TrayIcon"
                        IconSource="pack://application:,,,/Assets/astra_logo.ico"
                        ToolTipText="Astra Client"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show Astra Client" Click="MenuOpen_Click" />
                    <Separator />
                    <MenuItem Header="Exit" Click="MenuExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Border x:Name="RootBorder" Tag="RootBorder" CornerRadius="12"
            Background="{DynamicResource Brush.App.Background}"
            BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1">

        <Grid>
            <!-- Ambient depth glow -->
            <Border Background="{DynamicResource Brush.App.Glow}" CornerRadius="12" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============================ TITLE BAR ============================ -->
                <Border Grid.Row="0" x:Name="TitleBar" Height="48"
                        Background="{DynamicResource Brush.TitleBar.Fill}"
                        CornerRadius="12,12,0,0"
                        BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseRightButtonUp="TitleBar_MouseRightButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Popup x:Name="TitleBarMenu" PlacementTarget="{Binding ElementName=TitleBar}"
                               Placement="Bottom" HorizontalOffset="8" VerticalOffset="6"
                               AllowsTransparency="True" StaysOpen="False" Focusable="False"
                               PopupAnimation="Fade">
                                <Border x:Name="TitleBarMenuBorder" Background="#F2141A28"
                                    BorderBrush="{DynamicResource Brush.Glass.Border.Strong}"
                                    BorderThickness="1" CornerRadius="16" Padding="6"
                                    ClipToBounds="True" SnapsToDevicePixels="True"
                                    SizeChanged="PopupBorder_SizeChanged"
                                    Effect="{DynamicResource Effect.Flyout.Shadow}">
                                <StackPanel MinWidth="190">
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Home" Click="ContextNavHome_Click" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Browse" Click="ContextNavBrowse_Click" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Manage" Click="ContextNavManage_Click" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Output console" Click="ContextNavOutputConsole_Click" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Settings" Click="ContextNavSettings_Click" />
                                    <Border Height="1" Background="{DynamicResource Brush.Separator}" Margin="4,5" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Minimize" Click="Minimize_Click" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Maximize / Restore" Click="Maximize_Click" />
                                    <Button Style="{StaticResource FlyoutMenuItem}" Content="Exit" Click="Close_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- Logo + title (far-left) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,8,0">
                            <Button Style="{StaticResource IconButton}" Width="30" Height="30"
                                    Command="{Binding GoBackCommand}"
                                    ToolTip="Go back (Alt+Left)" Margin="0,0,6,0">
                                <Path Data="{StaticResource Icon.ChevronLeft}" Width="15" Height="15"
                                      Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Brush.Accent.Gradient}">
                                <Path Data="{StaticResource Icon.Sparkle}" Fill="White" Width="15" Height="15"
                                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" FontSize="14.5" FontWeight="SemiBold">
                                <Run Text="Astra" Foreground="{DynamicResource Brush.Text.Primary}" /><Run
                                     Text=" Client" Foreground="{DynamicResource Brush.Text.Muted}" FontWeight="Normal" />
                            </TextBlock>
                        </StackPanel>

                        <!-- Rounded reclick-safe menu strip -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Grid>
                                <ToggleButton x:Name="FileMenuToggle" Style="{StaticResource ToggleButton.Ghost}"
                                                  Content="File" Padding="10,6" Margin="0,0,2,0"
                                                  ClickMode="Press" Click="MenuStripToggle_Click" />
                                <Popup x:Name="FileMenuPopup" PlacementTarget="{Binding ElementName=FileMenuToggle}" Placement="Bottom"
                                       VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsChecked, ElementName=FileMenuToggle, Mode=TwoWay}"
                                       Closed="MenuPopup_Closed">
                                        <Border x:Name="FileMenuBorder" Background="#F2141A28" BorderBrush="{DynamicResource Brush.Glass.Border.Strong}"
                                            BorderThickness="1" CornerRadius="16" Padding="6" ClipToBounds="True"
                                            SnapsToDevicePixels="True" SizeChanged="PopupBorder_SizeChanged"
                                            Effect="{DynamicResource Effect.Flyout.Shadow}">
                                        <StackPanel MinWidth="190">
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="New Instance…" Click="MenuNewInstance_Click" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Open Data Folder" Click="MenuOpenDataFolder_Click" />
                                            <Border Height="1" Background="{DynamicResource Brush.Separator}" Margin="4,5" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Exit" Click="MenuExit_Click" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid>
                                <ToggleButton x:Name="ViewMenuToggle" Style="{StaticResource ToggleButton.Ghost}"
                                                  Content="View" Padding="10,6" Margin="0,0,2,0"
                                                  ClickMode="Press" Click="MenuStripToggle_Click" />
                                <Popup x:Name="ViewMenuPopup" PlacementTarget="{Binding ElementName=ViewMenuToggle}" Placement="Bottom"
                                       VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsChecked, ElementName=ViewMenuToggle, Mode=TwoWay}"
                                       Closed="MenuPopup_Closed">
                                        <Border x:Name="ViewMenuBorder" Background="#F2141A28" BorderBrush="{DynamicResource Brush.Glass.Border.Strong}"
                                            BorderThickness="1" CornerRadius="16" Padding="6" ClipToBounds="True"
                                            SnapsToDevicePixels="True" SizeChanged="PopupBorder_SizeChanged"
                                            Effect="{DynamicResource Effect.Flyout.Shadow}">
                                        <StackPanel MinWidth="150">
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Home" Click="MenuNavHome_Click" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Browse" Click="MenuNavBrowse_Click" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Manage" Click="MenuNavManage_Click" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Output console" Click="MenuNavOutputConsole_Click" />
                                            <Border Height="1" Background="{DynamicResource Brush.Separator}" Margin="4,5" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Settings" Click="MenuNavSettings_Click" />
                                            <Button x:Name="SidebarMenuItem" Style="{StaticResource FlyoutMenuItem}" Click="ToggleSidebar_Click">
                                                <TextBlock x:Name="SidebarMenuLabel" Text="Collapse sidebar" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Grid>
                                <ToggleButton x:Name="HelpMenuToggle" Style="{StaticResource ToggleButton.Ghost}"
                                                  Content="Help" Padding="10,6"
                                                  ClickMode="Press" Click="MenuStripToggle_Click" />
                                <Popup x:Name="HelpMenuPopup" PlacementTarget="{Binding ElementName=HelpMenuToggle}" Placement="Bottom"
                                       VerticalOffset="6" AllowsTransparency="True" StaysOpen="False" Focusable="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsChecked, ElementName=HelpMenuToggle, Mode=TwoWay}"
                                       Closed="MenuPopup_Closed">
                                        <Border x:Name="HelpMenuBorder" Background="#F2141A28" BorderBrush="{DynamicResource Brush.Glass.Border.Strong}"
                                            BorderThickness="1" CornerRadius="16" Padding="6" ClipToBounds="True"
                                            SnapsToDevicePixels="True" SizeChanged="PopupBorder_SizeChanged"
                                            Effect="{DynamicResource Effect.Flyout.Shadow}">
                                        <StackPanel MinWidth="190">
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="About Astra Client" Click="MenuAbout_Click" />
                                            <Button Style="{StaticResource FlyoutMenuItem}" Content="Release history" Click="MenuReleaseHistory_Click" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <!-- Account / user area (right) — ToggleButton+Popup for reclick-safe flyout -->
                        <Grid Grid.Column="3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <ToggleButton x:Name="AccountToggle" Style="{StaticResource ToggleButton.Ghost}"
                                          ClickMode="Press" Padding="8,5">
                                <StackPanel Orientation="Horizontal">
                                        <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True"
                                            Background="{DynamicResource Brush.Accent.Gradient}">
                                        <Grid>
                                            <TextBlock Text="{Binding AccountInitials}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding AccountAvatarUrl}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Margin="9,0,6,0">
                                        <TextBlock Text="{Binding AccountLabel}" FontSize="12.5" FontWeight="Medium"
                                                   Foreground="{DynamicResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding AccountKind}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.Text.Muted}" />
                                    </StackPanel>
                                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="{DynamicResource Brush.Text.Muted}"
                                          Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="AccountFlyout"
                                   PlacementTarget="{Binding ElementName=AccountToggle}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="6"
                                   StaysOpen="False"
                                   IsOpen="{Binding IsChecked, ElementName=AccountToggle, Mode=TwoWay}">
                                <Border x:Name="AccountFlyoutBorder"
                                    Style="{StaticResource Flyout.Panel}"
                                    MinWidth="{Binding ActualWidth, ElementName=AccountToggle}"
                                    SizeChanged="PopupBorder_SizeChanged"
                                    ClipToBounds="True">
                                    <StackPanel>
                                        <Grid Margin="4,4,4,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="64" Height="96" CornerRadius="12"
                                                    Background="{DynamicResource Brush.Glass.Card}"
                                                    ClipToBounds="True">
                                                <Image Source="{Binding AccountSkinUrl}"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                                                <TextBlock Text="{Binding AccountLabel}"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AccountKind}"
                                                           Style="{StaticResource Text.Caption}" Margin="0,3,0,8" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource FlyoutMenuItem}"
                                                        Content="View skin" Padding="8,5"
                                                        Click="AccountViewSkin_Click" />
                                                    <Button Style="{StaticResource FlyoutMenuItem}"
                                                        Content="Change name" Padding="8,5"
                                                        Click="AccountOffline_Click" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Border Style="{StaticResource HSeparator}" Margin="4,0,4,4" />
                                        <Button Style="{StaticResource FlyoutMenuItem}" Content="Offline play"
                                                Click="AccountOffline_Click" />
                                        <Button Style="{StaticResource FlyoutMenuItem}" Content="Sign in with Microsoft…"
                                                Click="AccountMicrosoft_Click" />
                                        <Border Style="{StaticResource HSeparator}" Margin="4,4" />
                                        <Button Style="{StaticResource FlyoutMenuItem}" Content="Sign out"
                                                Click="AccountSignOut_Click"
                                                IsEnabled="{Binding IsLoggedIn}" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Window buttons (far-right) -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,8,0">
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Data="{StaticResource Icon.Minimize}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize">
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="{StaticResource Icon.Maximize}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="Maximized">
                                                    <Setter Property="Data" Value="{StaticResource Icon.Restore}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}" Click="Close_Click" ToolTip="Close">
                                <Path Data="{StaticResource Icon.Close}" Width="14" Height="14" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================ BODY ============================ -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource Brush.Chrome.Fill}"
                            CornerRadius="0,0,0,12"
                            BorderBrush="{DynamicResource Brush.Separator}" BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="MENU" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.Muted}" Margin="24,20,0,10" />

                            <StackPanel Grid.Row="1" Margin="12,0">
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                             Tag="{StaticResource Icon.Home}"
                                             Click="NavHome_Click"
                                             IsChecked="{Binding IsHomeActive, Mode=OneWay}">
                                    <TextBlock Text="Home" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                             Tag="{StaticResource Icon.Compass}"
                                             Click="NavBrowse_Click"
                                             IsChecked="{Binding IsBrowseActive, Mode=OneWay}">
                                    <TextBlock Text="Browse" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                             Tag="{StaticResource Icon.Manage}"
                                             Click="NavManage_Click"
                                             IsChecked="{Binding IsManageActive, Mode=OneWay}">
                                    <TextBlock Text="Manage" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                             Tag="{StaticResource Icon.Server}"
                                             Click="NavAternos_Click"
                                             IsChecked="{Binding IsAternosActive, Mode=OneWay}">
                                    <TextBlock Text="Aternos" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                             Tag="{StaticResource Icon.Settings}"
                                             Click="NavSettings_Click"
                                             IsChecked="{Binding IsSettingsActive, Mode=OneWay}">
                                    <TextBlock Text="Settings" />
                                </RadioButton>
                                <RadioButton Style="{StaticResource NavButton}" GroupName="nav"
                                             Tag="{StaticResource Icon.Terminal}"
                                             Click="NavOutputConsole_Click"
                                             IsChecked="{Binding IsOutputConsoleActive, Mode=OneWay}">
                                    <TextBlock Text="Output console" />
                                </RadioButton>
                            </StackPanel>

                            <!-- Footer: active instance / java status -->
                            <Border Grid.Row="2" Margin="12,8,12,14" Padding="12"
                                    Background="{DynamicResource Brush.Glass.Card}" CornerRadius="10"
                                    BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                                        <TextBlock Text="Ready" FontSize="11.5" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Astra Client v1.31.0" FontSize="10.5" Margin="0,6,0,0"
                                               Foreground="{DynamicResource Brush.Text.Muted}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Content host: all pages except Aternos -->
                    <ContentControl Grid.Column="1"
                                    x:Name="GenericPageHost"
                                    Content="{Binding CurrentViewModel}"
                                    Focusable="False" />

                    <!-- Aternos: permanently hosted so WebView2 HWND is never destroyed -->
                    <views:AternosView Grid.Column="1"
                                       x:Name="PersistentAternosView"
                                       DataContext="{Binding CurrentViewModel}" />

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
