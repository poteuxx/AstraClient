<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Palette (refined dark frosted glass, no neon) ============ -->
    <Color x:Key="Color.Bg.Deep">#FF0B0E16</Color>
    <Color x:Key="Color.Bg.Mid">#FF121725</Color>
    <Color x:Key="Color.Bg.Raise">#FF171D2C</Color>

    <Color x:Key="Color.Accent">#FF7C8CFF</Color>
    <Color x:Key="Color.Accent.Light">#FF9BA8FF</Color>
    <Color x:Key="Color.Accent.Deep">#FF5B68E0</Color>
    <Color x:Key="Color.Violet">#FF9A7CFF</Color>

    <Color x:Key="Color.Text.Primary">#FFE9ECF5</Color>
    <Color x:Key="Color.Text.Secondary">#FFA7AEC4</Color>
    <Color x:Key="Color.Text.Muted">#FF6E7691</Color>

    <Color x:Key="Color.Success">#FF54D18C</Color>
    <Color x:Key="Color.Warning">#FFE7B45A</Color>
    <Color x:Key="Color.Danger">#FFF0757F</Color>

    <!-- ============ Solid brushes ============ -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />

    <!-- App window background: layered deep gradient -->
    <LinearGradientBrush x:Key="Brush.App.Background" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF0B0E16" Offset="0" />
        <GradientStop Color="#FF131A2A" Offset="0.5" />
        <GradientStop Color="#FF0D1120" Offset="1" />
    </LinearGradientBrush>

    <!-- Faint top-left glow to give depth (very subtle, not neon) -->
    <RadialGradientBrush x:Key="Brush.App.Glow" GradientOrigin="0.15,0.05" Center="0.15,0.05" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#2A7C8CFF" Offset="0" />
        <GradientStop Color="#007C8CFF" Offset="1" />
    </RadialGradientBrush>

    <!-- Frosted glass panel fill (translucent) -->
    <LinearGradientBrush x:Key="Brush.Glass.Panel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0" />
        <GradientStop Color="#14FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass card fill (slightly stronger) -->
    <LinearGradientBrush x:Key="Brush.Glass.Card" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Glass card hover fill -->
    <LinearGradientBrush x:Key="Brush.Glass.Card.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3AFFFFFF" Offset="0" />
        <GradientStop Color="#1AFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Subtle hairline borders -->
    <SolidColorBrush x:Key="Brush.Glass.Border" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="Brush.Glass.Border.Strong" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Brush.Separator" Color="#18FFFFFF" />

    <!-- Accent gradient (buttons, progress fill, active pill) -->
    <LinearGradientBrush x:Key="Brush.Accent.Gradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF9BA8FF" Offset="0" />
        <GradientStop Color="#FF7C8CFF" Offset="0.5" />
        <GradientStop Color="#FF6A78F0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.Accent.Gradient.Hover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFADB8FF" Offset="0" />
        <GradientStop Color="#FF8B98FF" Offset="0.5" />
        <GradientStop Color="#FF7784F5" Offset="1" />
    </LinearGradientBrush>

    <!-- Progress track -->
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="#1FFFFFFF" />

    <!-- Sidebar / chrome tints -->
    <SolidColorBrush x:Key="Brush.Chrome.Fill" Color="#660D1120" />
    <SolidColorBrush x:Key="Brush.TitleBar.Fill" Color="#330B0E16" />

    <!-- Input field fill -->
    <SolidColorBrush x:Key="Brush.Input.Fill" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Input.Fill.Hover" Color="#24FFFFFF" />

    <!-- Selection / highlight -->
    <SolidColorBrush x:Key="Brush.Selection" Color="#337C8CFF" />

    <!-- Shadow effect for floating cards / flyouts -->
    <DropShadowEffect x:Key="Effect.Card.Shadow" BlurRadius="28" ShadowDepth="6" Direction="270"
                      Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="Effect.Flyout.Shadow" BlurRadius="40" ShadowDepth="8" Direction="270"
                      Opacity="0.55" Color="#000000" />

</ResourceDictionary>
