<UserControl x:Class="AstraClient.Views.AternosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:AstraClient.ViewModels"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:AternosViewModel}"
             d:DesignHeight="700" d:DesignWidth="900"
             Background="Transparent">
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.H1}" />
                <TextBlock Text="Manage your Aternos servers directly from Astra Client."
                           Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="ReloadButton" Content="Reload" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Padding="12,6" Style="{StaticResource Button.Ghost}"
                    Click="ReloadButton_Click" IsEnabled="False" />
        </Grid>

        <!-- WebView2 Host - NO CornerRadius/ClipToBounds: WebView2 is a native HWND, WPF clip is ignored -->
        <Border Grid.Row="1" Background="#FF161A22"
                BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1">
            <Grid>
                <wv2:WebView2 x:Name="AternosWebView" />

                <Border x:Name="LoadingOverlay" Background="#E8161A22" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                        <TextBlock x:Name="LoadingText" Text="Starting Aternos…" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorOverlay" Background="#FF161A22" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <TextBlock Text="Aternos could not be loaded" Style="{StaticResource Text.SectionHeader}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ErrorText" TextAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource Text.Body}" Margin="0,10,0,16" />
                        <Button Content="Try again" HorizontalAlignment="Center" Padding="14,7"
                                Style="{StaticResource Button.Primary}" Click="RetryButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
