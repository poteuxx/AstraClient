<UserControl x:Class="AstraClient.Views.OutputConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,16">
            <StackPanel>
                <TextBlock Text="OUTPUT CONSOLE"
                           FontFamily="Minecraft, Segoe UI"
                           FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}" />
                <TextBlock Text="Live Minecraft launcher and game output"
                           Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Border Background="{DynamicResource Brush.Glass.Card}" CornerRadius="9"
                        Padding="10,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding ActiveInstanceName}" Style="{StaticResource Text.Caption}"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                </Border>
                <Button Style="{StaticResource Button.Ghost}" Padding="10,6"
                        Command="{Binding CopyCommand}" ToolTip="Copy visible output">
                    <TextBlock Text="Copy" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Padding="10,6" Margin="8,0,0,0"
                        Command="{Binding OpenLogFolderCommand}" ToolTip="Open the instance log folder">
                    <TextBlock Text="Open logs" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Padding="10,6" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}" ToolTip="Clear the visible console">
                    <TextBlock Text="Clear" />
                </Button>
                <Button Style="{StaticResource Button.Primary}" Padding="10,6" Margin="8,0,0,0"
                        Command="{Binding StopGameCommand}" ToolTip="Stop the running Minecraft process">
                    <TextBlock Text="Stop game" Foreground="White" />
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card.Panel}" Padding="0"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#44101620" Padding="14,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="LIVE OUTPUT" FontFamily="Minecraft, Segoe UI"
                                   FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" />
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}"
                                   Margin="12,0,0,0" />
                    </StackPanel>
                </Border>
                <TextBox x:Name="OutputTextBox" Grid.Row="1"
                         Text="{Binding LogText, Mode=OneWay}"
                         Visibility="{Binding HasOutput, Converter={StaticResource BoolToVis}}"
                         IsReadOnly="True" IsUndoEnabled="False"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#CC0A0E16" BorderThickness="0"
                         Foreground="#FFD8E6D2" CaretBrush="Transparent"
                         Padding="16" FontFamily="Minecraft, Consolas"
                         FontSize="12" />
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVis}}">
                        <Border Width="58" Height="58" CornerRadius="16"
                            Background="{DynamicResource Brush.Glass.Card}"
                            HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Data="{StaticResource Icon.Terminal}" Width="30" Height="30"
                              Fill="{DynamicResource Brush.Accent}"
                              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="No game output yet"
                               FontFamily="Minecraft, Segoe UI" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               HorizontalAlignment="Center" />
                        <TextBlock Text="Launch an instance to stream its startup and runtime logs here."
                               Style="{StaticResource Text.Body}" TextAlignment="Center"
                               MaxWidth="360" Margin="0,8,0,0" />
                    </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
