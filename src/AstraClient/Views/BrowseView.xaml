<UserControl x:Class="AstraClient.Views.BrowseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AstraClient.Converters"
             xmlns:imaging="clr-namespace:AstraClient.Services.Imaging"
             xmlns:vm="clr-namespace:AstraClient.ViewModels">
    <Grid>
        <!-- ══════════════════════════════════════════════
             Detail flyout overlay (slides in from right)
        ══════════════════════════════════════════════════ -->
        <Grid>
            <!-- Main content area -->
            <Grid x:Name="MainContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Top toolbar: type tabs + search ── -->
                <Grid Grid.Row="0" Margin="20,16,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Type tabs -->
                    <Border Grid.Column="0" Background="{DynamicResource Brush.Glass.Card}"
                            BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
                            CornerRadius="11" Padding="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource TabPill}" GroupName="BrowseType"
                                             Content="Mods" Tag="mod"
                                             IsChecked="True"
                                             Checked="TypeTab_Checked"/>
                                <RadioButton Style="{StaticResource TabPill}" GroupName="BrowseType"
                                             Content="Modpacks" Tag="modpack"
                                             Checked="TypeTab_Checked"/>
                                <RadioButton Style="{StaticResource TabPill}" GroupName="BrowseType"
                                             Content="Plugins" Tag="plugin"
                                             Checked="TypeTab_Checked"/>
                                <RadioButton Style="{StaticResource TabPill}" GroupName="BrowseType"
                                             Content="Resource Packs" Tag="resourcepack"
                                             Checked="TypeTab_Checked"/>
                                <RadioButton Style="{StaticResource TabPill}" GroupName="BrowseType"
                                             Content="Shaders" Tag="shader"
                                             Checked="TypeTab_Checked"/>
                                <RadioButton Style="{StaticResource TabPill}" GroupName="BrowseType"
                                             Content="Datapacks" Tag="datapack"
                                             Checked="TypeTab_Checked"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Search box -->
                    <Grid Grid.Column="1" Margin="12,0">
                        <TextBox Style="{StaticResource TextBox.Search}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 x:Name="SearchBox"
                                 KeyDown="SearchBox_KeyDown"/>
                        <Path Data="{StaticResource Icon.Search}"
                              Fill="{DynamicResource Brush.Text.Muted}"
                              Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="12,0" IsHitTestVisible="False"/>
                        <TextBlock Text="Search mods, packs, shaders…" IsHitTestVisible="False"
                                   Foreground="{DynamicResource Brush.Text.Muted}" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="38,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Query}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Search button -->
                    <Button Grid.Column="2" Style="{StaticResource Button.Primary}"
                            Command="{Binding SearchCommand}"
                            Padding="16,9">
                        <TextBlock Text="Search" FontWeight="SemiBold"/>
                    </Button>
                </Grid>

                <!-- ── Modpack import / share tools ── -->
                <Border Grid.Row="1" Margin="20,8,20,0" Style="{StaticResource Card.Panel}" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MODPACK" Style="{StaticResource Text.Caption}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Base}"
                                 Text="{Binding ModpackImportLink, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Paste Modrinth URL or share code (modrinth:modpack:slug)"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0"
                                Command="{Binding ImportModpackLinkCommand}" Padding="12,8">
                            <TextBlock Text="Import link"/>
                        </Button>
                        <Button Grid.Column="3" Style="{StaticResource Button.Primary}" Margin="8,0,0,0"
                                Command="{Binding ImportModpackFileCommand}" Padding="12,8">
                            <TextBlock Text="Import .mrpack" Foreground="White" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── Filter row ── -->
                <Grid Grid.Row="2" Margin="20,10,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Version:" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1" Width="110" IsEditable="True"
                              ItemsSource="{Binding GameVersions}"
                              Text="{Binding SelectedGameVersion, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="Filter by Minecraft version (e.g. 1.21.1)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="">
                                                    <Setter Property="Text" Value="(Any)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Loader:" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,8,0"
                               Visibility="{Binding ShowLoaderFilter, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Grid.Column="3" Width="120"
                              SelectedValue="{Binding SelectedLoader}"
                              SelectedValuePath="Tag"
                              ToolTip="Filter by mod loader"
                              Visibility="{Binding ShowLoaderFilter, Converter={StaticResource BoolToVis}}">
                        <ComboBoxItem Content="Any" Tag=""/>
                        <ComboBoxItem Content="fabric" Tag="fabric"/>
                        <ComboBoxItem Content="forge" Tag="forge"/>
                        <ComboBoxItem Content="neoforge" Tag="neoforge"/>
                        <ComboBoxItem Content="quilt" Tag="quilt"/>
                    </ComboBox>

                    <TextBlock Grid.Column="4" Text="Category:" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <ComboBox Grid.Column="5" Width="130"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                              ToolTip="Filter by Modrinth category">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="">
                                                    <Setter Property="Text" Value="(Any)"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Column="6" Text="Side:" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="14,0,8,0"/>
                    <ComboBox Grid.Column="7" Width="100"
                              SelectedValue="{Binding SelectedEnvironment}"
                              SelectedValuePath="Tag"
                              ToolTip="Client or server environment">
                        <ComboBoxItem Content="Any" Tag="" IsSelected="True"/>
                        <ComboBoxItem Content="Client" Tag="client"/>
                        <ComboBoxItem Content="Server" Tag="server"/>
                    </ComboBox>

                    <StackPanel Grid.Column="8" Orientation="Horizontal" Margin="14,0,0,0">
                        <TextBlock Text="Sort:" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="130" SelectedValue="{Binding Sort}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="Relevance" Tag="relevance" IsSelected="True"/>
                            <ComboBoxItem Content="Most downloads" Tag="downloads"/>
                            <ComboBoxItem Content="Most followers" Tag="follows"/>
                            <ComboBoxItem Content="Newest" Tag="newest"/>
                            <ComboBoxItem Content="Recently updated" Tag="updated"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- ── Results grid ── -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="20,12,20,0">
                    <StackPanel>
                        <!-- Results wrap panel -->
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ModrinthHitViewModel}">
                                    <!-- Project Card -->
                                    <Border Width="240" Margin="0,0,12,12" CornerRadius="14"
                                            BorderThickness="1" Cursor="Hand"
                                            BorderBrush="{DynamicResource Brush.Glass.Border}">
                                        <!-- Color accent left strip from project color -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush.Glass.Card}"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Glass.Card.Hover}"/>
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                                                     To="-3" Duration="0:0:0.12"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y"
                                                                                     To="0" Duration="0:0:0.16"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectHitCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <!-- Color accent bar at top -->
                                            <Border Height="4" VerticalAlignment="Top" CornerRadius="14,14,0,0"
                                                    Background="{Binding Hit.Color, Converter={StaticResource IntColorToBrush}}"/>
                                            <StackPanel Margin="14,12">
                                                <!-- Icon + title row -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Icon -->
                                                    <Border Grid.Column="0" Width="44" Height="44"
                                                            CornerRadius="10"
                                                            Background="{DynamicResource Brush.Glass.Card}"
                                                            BorderBrush="{DynamicResource Brush.Glass.Border}"
                                                            BorderThickness="1">
                                                        <Image Source="{Binding Icon}"
                                                               Width="40" Height="40"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                    <!-- Title / author -->
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Hit.Title}"
                                                                   FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Hit.Author}"
                                                                   Style="{StaticResource Text.Caption}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Description -->
                                                <TextBlock Text="{Binding Hit.Description}"
                                                           Style="{StaticResource Text.Body}"
                                                           FontSize="11.5" MaxHeight="48"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,8,0,8"
                                                           TextWrapping="Wrap"/>

                                                <!-- Categories -->
                                                <TextBlock Text="{Binding CategoriesLabel}"
                                                           Style="{StaticResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,0,8"/>

                                                <!-- Stats row -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.CloudDownload}"
                                                          Width="13" Height="13" Stretch="Uniform"
                                                          Fill="{DynamicResource Brush.Text.Muted}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding DownloadsLabel}"
                                                               Style="{StaticResource Text.Caption}"/>
                                                    <Path Data="{StaticResource Icon.Star}"
                                                          Width="12" Height="12" Stretch="Uniform"
                                                          Fill="{DynamicResource Brush.Warning}"
                                                          Margin="12,0,4,0"/>
                                                    <TextBlock Text="{Binding Hit.Follows, Converter={StaticResource CompactNumber}}"
                                                               Style="{StaticResource Text.Caption}"/>
                                                    <!-- Installed badge -->
                                                    <Border CornerRadius="4" Background="#1A54D18C"
                                                            Padding="5,2" Margin="10,0,0,0"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="✓ Installed" FontSize="10"
                                                                   Foreground="{DynamicResource Brush.Success}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Load More -->
                        <Button Style="{StaticResource Button.Ghost}"
                                Command="{Binding LoadMoreCommand}"
                                HorizontalAlignment="Center"
                                Padding="24,10" Margin="0,4,0,16"
                                Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Load More Results"/>
                        </Button>

                        <!-- Empty state -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,60">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Results.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Icon.Search}"
                                  Width="48" Height="48" Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Status bar ── -->
                <Border Grid.Row="4" Margin="20,6,20,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                   Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                        <!-- Busy indicator -->
                        <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource Brush.Selection}"
                                Padding="10,4"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Loading…" Style="{StaticResource Text.Caption}"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════
                 Detail flyout panel
            ══════════════════════════════ -->
            <Grid Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
                <!-- Semi-transparent backdrop -->
                <Border Background="#99000000">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailCommand}"/>
                    </Border.InputBindings>
                </Border>

                <!-- Flyout panel (right-aligned) -->
                <Border Width="480" HorizontalAlignment="Right"
                        Background="#F0141A28"
                        BorderBrush="{DynamicResource Brush.Glass.Border}"
                        BorderThickness="1,0,0,0"
                        Effect="{DynamicResource Effect.Flyout.Shadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Flyout header -->
                        <Border Grid.Row="0" Padding="20,16"
                                BorderBrush="{DynamicResource Brush.Separator}"
                                BorderThickness="0,0,0,1">
                            <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon -->
                                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                                        Background="{DynamicResource Brush.Glass.Card}"
                                        BorderBrush="{DynamicResource Brush.Glass.Border}"
                                        BorderThickness="1">
                                    <Image Source="{Binding SelectedHit.Icon}"
                                           Width="44" Height="44"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedHit.Hit.Title}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Text.Primary}"/>
                                    <TextBlock Text="{Binding SelectedHit.Hit.Author}"
                                               Style="{StaticResource Text.Caption}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Path Data="{StaticResource Icon.CloudDownload}"
                                              Width="12" Height="12" Stretch="Uniform"
                                              Fill="{DynamicResource Brush.Text.Muted}" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding SelectedHit.DownloadsLabel}"
                                                   Style="{StaticResource Text.Caption}"/>
                                        <Path Data="{StaticResource Icon.Star}"
                                              Width="11" Height="11" Stretch="Uniform"
                                              Fill="{DynamicResource Brush.Warning}" Margin="10,0,4,0"/>
                                        <TextBlock Text="{Binding SelectedHit.Hit.Follows, Converter={StaticResource CompactNumber}}"
                                                   Style="{StaticResource Text.Caption}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,6" Margin="0,0,6,0"
                                            Command="{Binding OpenOnModrinthCommand}" ToolTip="Open on Modrinth">
                                        <TextBlock Text="Open" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,6" Margin="0,0,6,0"
                                            Command="{Binding CopyShareLinkCommand}" ToolTip="Copy share URL">
                                        <TextBlock Text="Copy link" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,6" Margin="0,0,6,0"
                                            Command="{Binding CopyShareCodeCommand}" ToolTip="Copy compact share code">
                                        <TextBlock Text="Copy code" FontSize="11"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}"
                                            Command="{Binding CloseDetailCommand}"
                                            Width="32" Height="32" VerticalAlignment="Top">
                                        <Path Data="{StaticResource Icon.Close}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource Brush.Text.Secondary}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ShareLinkPreview}" Style="{StaticResource Text.Caption}"
                                       Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="Share link for the selected version"/>
                            </StackPanel>
                        </Border>

                        <!-- Flyout body: description + version picker -->
                        <ScrollViewer Grid.Row="1" Padding="20,14">
                            <StackPanel>
                                <!-- Categories -->
                                <TextBlock Text="{Binding SelectedHit.CategoriesLabel}"
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,0,0,12"/>

                                <!-- Description / body -->
                                <TextBlock Text="{Binding DetailBody}"
                                           Style="{StaticResource Text.Body}"
                                           FontSize="12.5" TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <!-- Every gallery image returned by Modrinth is rendered through the shared cache. -->
                                <ItemsControl ItemsSource="{Binding DetailGallery}" Margin="0,0,0,16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="136" Height="88" Margin="0,0,8,8" CornerRadius="10"
                                                    Background="{DynamicResource Brush.Glass.Card}" ClipToBounds="True">
                                                <Image imaging:AsyncImageBehavior.Source="{Binding}" Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Supported game versions -->
                                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="GAME VERSIONS" Style="{StaticResource Text.Caption}"
                                                   FontWeight="Bold" Margin="0,0,0,8"/>
                                        <WrapPanel>
                                            <ItemsControl ItemsSource="{Binding SelectedHit.Hit.Versions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Background="{DynamicResource Brush.Glass.Card}"
                                                                BorderBrush="{DynamicResource Brush.Glass.Border}" BorderThickness="1"
                                                                Padding="6,3" Margin="0,0,4,4">
                                                            <TextBlock Text="{Binding}" FontSize="11"
                                                                       Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Version picker -->
                                <TextBlock Text="SELECT VERSION TO INSTALL" Style="{StaticResource Text.Caption}"
                                           FontWeight="Bold" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding DetailVersions}"
                                          SelectedItem="{Binding SelectedDetailVersion}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}">
                                                    <Run Text="{Binding VersionNumber}"/>
                                                    <Run Text="·"/>
                                                    <Run Text="{Binding DatePublished, StringFormat='{}{0:yyyy-MM-dd}'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Files -->
                                <TextBlock Text="FILES"
                                           FontWeight="Bold" Margin="0,14,0,8"
                                           Visibility="{Binding SelectedDetailVersion, Converter={StaticResource NullPlaceholder},
                                               ConverterParameter=hidden}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetailVersion}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding SelectedDetailVersion.Files}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Filename}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource Brush.Text.Primary}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource Brush.Text.Muted}">
                                                            <Run Text="{Binding Size, Converter={StaticResource CompactNumber}}"/>
                                                            <Run Text="bytes"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="4"
                                                            Background="#1A7C8CFF" Padding="6,2"
                                                            Visibility="{Binding Primary, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Primary" FontSize="10"
                                                                   Foreground="{DynamicResource Brush.Accent}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Install button -->
                        <Border Grid.Row="2" Padding="20,14"
                                BorderBrush="{DynamicResource Brush.Separator}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding InstallFooterLabel}" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               Text="{Binding StatusText}"
                                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Primary}"
                                        Command="{Binding InstallCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Padding="20,10">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Download}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Fill="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding InstallActionLabel}" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
