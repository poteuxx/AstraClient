<UserControl x:Class="AstraClient.Views.ManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AstraClient.Converters">
    <UserControl.Resources>
        <conv:StringEqualityConverter x:Key="StringEqualityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: instance list -->
            <ColumnDefinition Width="260" MinWidth="200"/>
            <!-- Right: detail editor -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════ LEFT — Instance List ═══════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource Brush.Chrome.Fill}"
                BorderBrush="{DynamicResource Brush.Separator}"
            BorderThickness="0,0,1,0"
            CornerRadius="12,0,0,12"
            ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="16,14,16,10"
                        BorderBrush="{DynamicResource Brush.Separator}"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="INSTANCES" Style="{StaticResource Text.Caption}"
                                   FontWeight="Bold"/>
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Margin="0,3,0,0">
                            <Run Text="{Binding Instances.Count, Mode=OneWay}"/>
                            <Run Text="instance(s)"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Instance items -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel>
                        <!-- Empty state -->
                        <StackPanel Margin="8,20" HorizontalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Instances.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Path Data="{StaticResource Icon.Cube}"
                                  Width="30" Height="30" Stretch="Uniform"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No instances yet." Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Use the form below to create one."
                                       Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Instances}"
                                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" CornerRadius="10" Padding="12,10"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Glass.Card}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Selection}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource Brush.Text.Primary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,2" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Text.Muted}">
                                                <Run Text="{Binding GameVersion}"/>
                                                <Run Text="·"/>
                                                <Run Text="{Binding Loader}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Background="#1A54D18C"
                                                    Padding="5,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource StringEqualityConverter}">
                                                                        <Binding Path="Id"/>
                                                                        <Binding Path="DataContext.ActiveInstanceId"
                                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="Active" FontSize="10"
                                                           Foreground="{DynamicResource Brush.Success}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Create new instance form -->
                <Border Grid.Row="2" Padding="12,12"
                        BorderBrush="{DynamicResource Brush.Separator}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="NEW INSTANCE" Style="{StaticResource Text.Caption}"
                                   FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource TextBox.Base}"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7" Margin="0,0,0,6"
                                 ToolTip="Instance name"/>
                        <TextBox Style="{StaticResource TextBox.Base}"
                                 Text="{Binding NewVersion, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="10,7" Margin="0,0,0,8"
                                 ToolTip="Minecraft version (e.g. 1.21.1)"/>
                        <Button Style="{StaticResource Button.Primary}"
                                Command="{Binding CreateInstanceCommand}"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Plus}"
                                      Width="14" Height="14" Stretch="Uniform"
                                      Fill="White" Margin="0,0,6,0"/>
                                <TextBlock Text="Create" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════ RIGHT — Instance Editor ═══════════════════ -->
        <Grid Grid.Column="1">

            <!-- No-selection placeholder -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                <Path Data="{StaticResource Icon.Manage}"
                      Width="48" Height="48" Stretch="Uniform"
                      Fill="{DynamicResource Brush.Text.Muted}"
                      HorizontalAlignment="Center"/>
                <TextBlock Text="Select or create an instance" Style="{StaticResource Text.Body}"
                           HorizontalAlignment="Center" Margin="0,16,0,4"/>
                <TextBlock Text="to manage its settings, mods and loaders."
                           Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Instance editor (visible when selection exists) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="24,20">

                    <!-- ── Toolbar ── -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedInstance.Name}"
                                       Style="{StaticResource Text.Title}" FontSize="20"/>
                            <TextBlock Margin="0,3" FontSize="12"
                                       Foreground="{DynamicResource Brush.Text.Muted}">
                                <Run Text="{Binding SelectedInstance.GameVersion}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding SelectedInstance.Loader}"/>
                                <Run Text="·"/>
                                <Run Text="{Binding SelectedInstance.MemoryMb}"/>
                                <Run Text="MB"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding SetActiveCommand}"
                                    Padding="12,8" Margin="0,0,8,0"
                                    ToolTip="Set as active (launches on Play)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Play}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Set Active"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding OpenInstanceFolderCommand}"
                                    Padding="12,8" Margin="0,0,8,0"
                                    ToolTip="Open instance folder in Explorer">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Folder}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Text.Secondary}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Open Folder"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}"
                                    Command="{Binding DeleteInstanceCommand}"
                                    Padding="12,8"
                                    ToolTip="Delete this instance permanently"
                                    Foreground="{DynamicResource Brush.Danger}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Trash}"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Fill="{DynamicResource Brush.Danger}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Delete"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- ── Modpack import / export ── -->
                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="MODPACK IMPORT &amp; EXPORT" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Export the selected instance as a Modrinth .mrpack, or import a pack from disk to create a new instance."
                                       Style="{StaticResource Text.Body}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Primary}" Padding="14,9" Margin="0,0,8,0"
                                        Command="{Binding ExportModpackCommand}"
                                        ToolTip="Export mods, configs and packs to .mrpack">
                                    <TextBlock Text="Export .mrpack" Foreground="White" FontWeight="SemiBold"/>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Padding="14,9"
                                        Command="{Binding ImportModpackFileCommand}"
                                        ToolTip="Import a local .mrpack file">
                                    <TextBlock Text="Import .mrpack"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── Basic settings card ── -->
                    <Border Style="{StaticResource Card.Panel}" Padding="20" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                       Text="BASIC SETTINGS" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" Margin="0,0,0,14"/>

                            <!-- Name -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                                <TextBlock Text="Instance Name" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource TextBox.Base}"
                                         Text="{Binding InstanceName, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"/>
                            </StackPanel>

                            <!-- Version -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                                <TextBlock Text="Minecraft Version" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource TextBox.Base}"
                                         Text="{Binding InstanceVersion, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"/>
                            </StackPanel>

                            <!-- Memory -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,16">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Memory (MB)" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock HorizontalAlignment="Right" Style="{StaticResource Text.Caption}">
                                        <Run Text="{Binding InstanceMemory, Mode=OneWay}"/>
                                        <Run Text="MB" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                    </TextBlock>
                                </Grid>
                                <Slider Minimum="512" Maximum="32768" TickFrequency="512"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding InstanceMemory, Mode=TwoWay}"/>
                                <WrapPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Margin="0,0,6,0" FontSize="11.5" Tag="1024" Click="MemoryPreset_Click">1 GB</Button>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Margin="0,0,6,0" FontSize="11.5" Tag="2048" Click="MemoryPreset_Click">2 GB</Button>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Margin="0,0,6,0" FontSize="11.5" Tag="4096" Click="MemoryPreset_Click">4 GB</Button>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" Margin="0,0,6,0" FontSize="11.5" Tag="6144" Click="MemoryPreset_Click">6 GB</Button>
                                    <Button Style="{StaticResource Button.Ghost}" Padding="8,4" FontSize="11.5" Tag="8192" Click="MemoryPreset_Click">8 GB</Button>
                                </WrapPanel>
                                <CheckBox Style="{StaticResource CheckBox.Premium}"
                                          IsChecked="{Binding UseSavedMemory, Mode=TwoWay}"
                                          Content="Use saved default memory for new instances"
                                          Foreground="{DynamicResource Brush.Text.Primary}"
                                          Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Java override -->
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,0">
                                <TextBlock Text="Java Executable Override (leave blank = auto)"
                                           Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                                <TextBox Style="{StaticResource TextBox.Base}"
                                         Text="{Binding InstanceJavaOverride, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"/>
                            </StackPanel>

                            <!-- Save -->
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                                        Margin="0,16,0,0">
                                <Button Style="{StaticResource Button.Primary}"
                                        Command="{Binding SaveInstanceCommand}"
                                        Padding="16,9" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Check}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="White" Margin="0,0,6,0"/>
                                        <TextBlock Text="Save Instance" FontWeight="SemiBold" Foreground="White"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Success}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Mod Loader card ── -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="MOD LOADER" Style="{StaticResource Text.Caption}" FontWeight="Bold"/>
                                <Button HorizontalAlignment="Right" Style="{StaticResource Button.Ghost}"
                                        Command="{Binding FillRecommendedArgsCommand}"
                                        Padding="8,4" FontSize="11.5"
                                        ToolTip="Apply recommended JVM &amp; game args for the selected loader">
                                    <TextBlock Text="Auto-fill Args"/>
                                </Button>
                            </Grid>

                            <!-- Loader options -->
                            <ItemsControl ItemsSource="{Binding LoaderOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,10,10" CornerRadius="12"
                                                BorderThickness="2" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Glass.Card}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Glass.Border}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectLoaderCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <StackPanel Margin="16,10" MinWidth="100">
                                                <Border Width="34" Height="34" CornerRadius="10"
                                                        Background="{Binding Visual.Brush}"
                                                        HorizontalAlignment="Center" Margin="0,0,0,7">
                                                    <Grid>
                                                        <Image Source="{Binding Visual.ImageSource}" Width="28" Height="28" Stretch="Uniform"/>
                                                        <Path Data="{Binding Visual.Icon}" Fill="White"
                                                              Width="20" Height="20" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path.Style>
                                                                <Style TargetType="Path">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Visual.ImageSource}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Path.Style>
                                                        </Path>
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding LoaderName}"
                                                           FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Visual.Description}"
                                                           Style="{StaticResource Text.Caption}"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           MaxWidth="120" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding Recommended.Version}"
                                                           Style="{StaticResource Text.Caption}"
                                                           HorizontalAlignment="Center" Margin="0,3,0,0"
                                                           Visibility="{Binding IsSelected, Converter={StaticResource InverseBoolToVis}}"/>
                                                
                                                <ComboBox ItemsSource="{Binding AllVersions}"
                                                          SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                          DisplayMemberPath="Version"
                                                          Margin="0,6,0,0" MinWidth="110"
                                                          Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>
                                                <Border CornerRadius="4" Background="#1A54D18C"
                                                        Padding="5,2" HorizontalAlignment="Center"
                                                        Margin="0,5,0,0"
                                                        Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Available" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Success}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Loading state -->
                            <TextBlock Text="Checking loader availability…" Style="{StaticResource Text.Caption}"
                                       Margin="0,4"
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ── JVM / Game Args card ── -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="JVM &amp; GAME ARGUMENTS" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" Margin="0,0,0,14"/>

                            <TextBlock Text="JVM Arguments" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource TextBox.Base}"
                                     Text="{Binding InstanceJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"
                                     Padding="10,8" FontFamily="Consolas" FontSize="12"/>

                            <TextBlock Text="Game Arguments" Style="{StaticResource Text.Caption}"
                                       Margin="0,12,0,5"/>
                            <TextBox Style="{StaticResource TextBox.Base}"
                                     Text="{Binding InstanceGameArgs, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" MinHeight="50" TextWrapping="Wrap"
                                     Padding="10,8" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- ── Installed Library card ── -->
                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="INSTALLED CONTENT" Style="{StaticResource Text.Caption}"
                                       FontWeight="Bold" Margin="0,0,0,12"/>

                            <!-- Empty state -->
                            <TextBlock Text="No mods or content installed. Browse → to install."
                                       FontSize="12"
                                       Margin="0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Library.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding Library}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Type icon -->
                                                <Border Grid.Column="0" Width="32" Height="32"
                                                        CornerRadius="7" Background="{DynamicResource Brush.Selection}"
                                                        Margin="0,0,10,0">
                                                    <Path Width="16" Height="16" Stretch="Uniform"
                                                          Fill="{DynamicResource Brush.Accent}">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Data" Value="{StaticResource Icon.Mods}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="resourcepack">
                                                                        <Setter Property="Data" Value="{StaticResource Icon.ResourcePack}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="shader">
                                                                        <Setter Property="Data" Value="{StaticResource Icon.Shader}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="datapack">
                                                                        <Setter Property="Data" Value="{StaticResource Icon.Datapack}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Border>
                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.Text.Primary}"
                                                               FontSize="13"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.Text.Muted}">
                                                        <Run Text="{Binding FileName}"/>
                                                        <Run Text="·"/>
                                                        <Run Text="{Binding SizeBytes, Converter={StaticResource CompactNumber}}"/>
                                                        <Run Text="B"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <!-- Enabled badge -->
                                                <Border Grid.Column="2" CornerRadius="4"
                                                        Padding="6,2" Margin="8,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#1A54D18C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                    <Setter Property="Background" Value="#1AF0757F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Enabled"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="Text" Value="Disabled"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <!-- Remove -->
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                        Width="28" Height="28"
                                                        Command="{Binding DataContext.RemoveContentCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Remove this content">
                                                    <Path Data="{StaticResource Icon.Trash}"
                                                          Width="14" Height="14" Stretch="Uniform"
                                                          Fill="{DynamicResource Brush.Danger}"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Status bar -->
                    <Border Padding="0,4,0,0">
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}"
                                   Foreground="{DynamicResource Brush.Success}"/>
                    </Border>

                    <!-- Bottom padding -->
                    <Border Height="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
